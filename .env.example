# Airwallex Sandbox Credentials (Get from https://www.sandbox.airwallex.com/app/#/developer/api-keys)
AIRWALLEX_API_URL=https://api-sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=your_client_id_here
AIRWALLEX_API_KEY=your_api_key_here

# LLM & Agent Configuration
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=claude-3-5-sonnet-20241022

# Governance & Human-In-The-Loop (HITL) Thresholds
HIGH_VALUE_THRESHOLD_USD=25000.0
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
